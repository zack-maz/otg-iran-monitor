# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.dev-cache
# Output of scripts/snapshot-*.ts and scripts/probe-openrouter.ts
.snapshots
dist
dist-server
# NOTE: api/vercel-entry.js is the tsup-bundled serverless function entry
# that Vercel detects as a function. It MUST be tracked in git so Vercel's
# function discovery sees it during deploy (the Vite framework preset only
# auto-ships dist/, not api/). Build script regenerates it on every build,
# so contributors should run `npm run build` before committing if they
# touched server code.
dist-ssr
*.tsbuildinfo
*.local

# Environment variables
.env
.env.*
!.env.example

# Server runtime state
.backfill-state.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
.env*.local

# Load test results
load-test-results/

# Test artifacts
test-results/
.playwright-mcp/
coverage/

# Capture script scratch space (scripts/capture-hero.ts intermediate frames)
tmp/

# MCP config
.mcp.json

# Claude Code per-session state (agent worktrees, local settings, scheduled-task locks)
.claude/

# Phase 31 D-02 fix-forward — eval fixtures copied from .planning/eval/ at build time
api/_eval/
