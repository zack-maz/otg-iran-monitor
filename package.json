{
  "name": "otg-iran-monitor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm --watch server/index.ts",
    "build": "vite build && tsup server/vercel-entry.ts --format esm --out-dir api --no-splitting --tsconfig tsconfig.server.json && mkdir -p api/_eval && cp server/data/eval/ground-truth-events.json server/data/eval/adversarial-injections.json api/_eval/",
    "typecheck": "tsc -b && type-coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:env": "tsx scripts/check-env-example.ts",
    "capture:hero": "tsx scripts/capture-hero.ts",
    "capture:layers": "tsx scripts/capture-hero.ts --layers",
    "refresh:water": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/refresh-water-facilities.ts",
    "refresh:sites": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/refresh-sites.ts",
    "eval:replay": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/eval-replay.ts",
    "probe:openrouter": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/probe-openrouter.ts",
    "analyze:llm-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/analyze-llm-run.ts",
    "eval:detail": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/eval-detail.ts",
    "snapshot:v3": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/snapshot-v3-redis.ts",
    "audit:gdelt": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/audit-gdelt-corpus.ts",
    "audit:water": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/audit-water-names.ts",
    "watch:snapshot": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/snapshot-cron-watch.ts",
    "bakeoff": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx/esm scripts/bakeoff-v3-direct.ts",
    "bakeoff:preflight": "npm run bakeoff -- --models=qwen/qwen3.5-397b-a17b,meta/llama-3.3-70b-instruct,nvidia/nemotron-3-super-120b-a12b,z-ai/glm4.7 --limit=20 --mode=characterize",
    "bakeoff:full": "npm run bakeoff -- --models=qwen/qwen3.5-397b-a17b,meta/llama-3.3-70b-instruct,nvidia/nemotron-3-super-120b-a12b,z-ai/glm4.7 --limit=50",
    "type-coverage": "type-coverage",
    "preview": "vite preview",
    "openapi:lint": "redocly lint server/openapi.yaml --format=stylish",
    "docs:lint": "markdown-link-check --quiet --config .markdown-link-check.json README.md && find docs -name '*.md' -not -path '*/brainstorms/*' -not -path '*/superpowers/*' -print0 | xargs -0 -n1 markdown-link-check --quiet --config .markdown-link-check.json",
    "prepare": "husky"
  },
  "typeCoverage": {
    "atLeast": 97,
    "strict": true,
    "project": "tsconfig.server.json",
    "detail": true,
    "ignoreCatch": true
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@deck.gl/core": "^9.2.11",
    "@deck.gl/extensions": "^9.2.11",
    "@deck.gl/layers": "^9.2.11",
    "@deck.gl/mapbox": "^9.2.11",
    "@tailwindcss/vite": "^4.2.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.5.0",
    "@vercel/speed-insights": "^2.0.0",
    "@vis.gl/react-maplibre": "^8.1.0",
    "adm-zip": "^0.5.16",
    "compression": "^1.8.1",
    "compromise": "^14.15.0",
    "cors": "^2.8.6",
    "driver.js": "1.4.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.5.8",
    "helmet": "^8.1.0",
    "maplibre-contour": "^0.1.0",
    "maplibre-gl": "^5.20.1",
    "openai": "^6.34.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.2.1",
    "transliteration": "2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.58.2",
    "@redocly/cli": "^2.31.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/geojson": "^7946.0.16",
    "@types/pino-http": "^5.8.4",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/shapefile": "^0.6.4",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.3",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "markdown-link-check": "^3.14.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "shapefile": "^0.6.6",
    "supertest": "^7.2.2",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vitest": "^4.1.0"
  }
}
